# Copy to .env.local and fill in values from the Supabase project settings.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer the publishable key. Legacy anon key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Comma-separated allowlist for magic-link login (required).
ALLOWED_EMAILS=you@example.com

# Public site URL used in magic-link redirects (local default).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — Phase 3 semantic search (L3). text-embedding-3-small = 1536 dims.
# OPENAI_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
