# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — commit only the placeholder template
.env*
!.env.example

# local editor / agent settings
.cursor/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/raw/
/import/normalized/
/import/staging/
/import/reports/
/import/processed/
!/import/normalized/.gitkeep
!/import/staging/.gitkeep
!/import/reports/.gitkeep
!/import/processed/.gitkeep
!/import/processed/runs/.gitkeep