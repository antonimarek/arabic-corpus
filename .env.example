# Copy to .env.local and fill in values from the Supabase project settings.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Prefer the publishable key. Legacy anon key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Comma-separated allowlist for password login (required).
ALLOWED_EMAILS=you@example.com

# Public site URL (local default). Used for metadata and optional auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — batch pattern discover CLI only (never expose to the browser).
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

